# Django REST API base (include /api/v1).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Vercel: set VITE_API_BASE_URL=/api/v1 in the Vercel project. vercel.json
# proxies /api/* to the VPS API (new-system.yanksandbrits.co.id) so auth cookies
# stay first-party (Safari blocks third-party cookies across domains).
