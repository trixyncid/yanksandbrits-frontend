# Django REST API base (include /api/v1).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Vercel staging: set VITE_API_BASE_URL=/api/v1 in the Vercel project. vercel.json
# proxies /api/* to the Railway API so auth cookies stay first-party (Safari
# blocks third-party cookies between *.vercel.app and *.up.railway.app).
